# --- WhatsApp Business Cloud API (from Meta developer dashboard) ---
# Prefer a System User token (expires_at: 0). The one on the API Setup
# page dies after 24h and shows up as error 190.
WHATSAPP_ACCESS_TOKEN=
# The numeric "Phone number ID" from API Setup, NOT the phone number.
# Doubles as a filter: messages sent to any other number on the business
# account are ignored, because Meta's webhook is app-wide.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-your-own-string

# Dev safety net. Comma-separated senders the bot is allowed to answer;
# everything else is ignored. EMPTY MEANS ANSWER EVERYONE (production).
# Set it whenever you test against a number real people also message.
WHATSAPP_ALLOWED_SENDERS=

# --- LLM (reasoning, drafting, routing) ---
ANTHROPIC_API_KEY=

# --- Speech-to-text ---
DEEPGRAM_API_KEY=

# --- Database ---
# Port 5433: 5432 is usually taken by another project's container, and
# pointing at the wrong one writes tables into someone else's database.
# The +asyncpg dialect is for SQLAlchemy; strip it for psql.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/whatsapp_ea

# --- Google Workspace OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# --- Signs the OAuth `state` parameter so /oauth/callback can
# distinguish a genuine round trip from a forged one. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
APP_SECRET_KEY=
